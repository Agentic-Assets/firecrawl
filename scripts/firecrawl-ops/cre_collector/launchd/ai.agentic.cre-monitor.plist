<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ai.agentic.cre-monitor.plist
  CRE monitor tier — cheap enumeration diff every 3 hours at :15.
  Runs cre_run_tier.sh monitor, which is guarded: if cre_monitor.py does not
  yet exist the script exits cleanly with a "not yet implemented" message.

  STATUS 2026-06-14: AUTHORIZED and loaded. Monitor runner proven on the
  all-source observe-only seed; CRE_MONITOR_APPLY=1 enables change-event
  recording (007 tables only; never cre_listings.status/deleted_at).
  See launchd/README.md for install/unload instructions.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.agentic.cre-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/caymanseagraves/Documents/GitHub/agentic-assets/firecrawl/scripts/firecrawl-ops/cre_collector/launchd/cre_run_tier.sh</string>
        <string>monitor</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/caymanseagraves/Documents/GitHub/agentic-assets/firecrawl/scripts/firecrawl-ops/cre_collector</string>

    <!--
      Every 3 hours at minute 15.  launchd has no native "every N hours"
      repeat, so we enumerate the eight start times explicitly.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/caymanseagraves/Documents/GitHub/agentic-assets/firecrawl/scripts/firecrawl-ops/cre_collector/out/daily/cre-monitor.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/caymanseagraves/Documents/GitHub/agentic-assets/firecrawl/scripts/firecrawl-ops/cre_collector/out/daily/cre-monitor.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- Authorized 2026-06-14: enable observe-only change-event recording.
             cre_monitor.py --apply writes ONLY the 007 tables (events / source_index /
             enrichment_queue) and neutral source_lastmod / canonical_key; it never
             writes cre_listings.status or deleted_at. -->
        <key>CRE_MONITOR_APPLY</key>
        <string>1</string>
    </dict>
</dict>
</plist>
