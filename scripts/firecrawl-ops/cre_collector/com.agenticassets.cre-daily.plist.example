<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily CRE listing refresh via launchd (06:30 local).

  Install:
    cp com.agenticassets.cre-daily.plist.example \
       ~/Library/LaunchAgents/com.agenticassets.cre-daily.plist
    # adjust the script path below if the repo lives elsewhere
    launchctl load ~/Library/LaunchAgents/com.agenticassets.cre-daily.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.agenticassets.cre-daily.plist

  The script aborts safely if the local Firecrawl stack is down.
  Logs land in cre_collector/out/daily/.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agenticassets.cre-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/caymanseagraves/Documents/GitHub/agentic-assets/firecrawl/scripts/firecrawl-ops/cre_collector/cre_daily_update.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/cre-daily.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cre-daily.launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
