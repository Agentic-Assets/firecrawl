<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEPRECATED. Do not copy this file.

  Scheduling is now generated per-machine (no hardcoded paths, shared flock-
  free lock, correct ai.agentic.cre-* labels) by:

      bash launchd/install_launchd.sh all              # render + install (gated)
      bash launchd/install_launchd.sh --load daily     # install + load one tier

  The source of truth is launchd/ai.agentic.cre-{daily,monitor,weekly}.plist.template
  plus launchd/install_launchd.sh. See launchd/README.md and SETUP.md.

  This stub is kept only so older notes that reference the filename still resolve
  to an explanation. The placeholder body below is intentionally non-functional
  (it points at a placeholder path and the legacy direct entrypoint) so it cannot
  be loaded by mistake. Use install_launchd.sh instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agenticassets.cre-daily.DEPRECATED</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/ABSOLUTE/PATH/TO/firecrawl/scripts/firecrawl-ops/cre_collector/launchd/cre_run_tier.sh</string>
        <string>daily</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
